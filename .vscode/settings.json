{
  "rust-analyzer.cargo.allTargets": false,
  "rust-analyzer.cargo.buildScripts.enable": true,
  "rust-analyzer.cargo.buildScripts.overrideCommand": [
    "cargo",
    "+stable",
    "run",
    "--quiet",
    "-p",
    "xtask",
    "--",
    "knob",
    "ide-check"
  ],
  "rust-analyzer.cargo.buildScripts.useRustcWrapper": false,
  "rust-analyzer.cargo.extraEnv": {
    "RUSTUP_TOOLCHAIN": "nightly-2026-04-15"
  },
  "rust-analyzer.cargo.sysroot": "discover",
  "rust-analyzer.cargo.target": "riscv32imac-esp-espidf",
  "rust-analyzer.cfg.setTest": false,
  "rust-analyzer.check.overrideCommand": [
    "cargo",
    "+stable",
    "run",
    "--quiet",
    "-p",
    "xtask",
    "--",
    "knob",
    "ide-check"
  ],
  "rust-analyzer.files.exclude": [
    "firmware/display"
  ],
  "rust-analyzer.linkedProjects": [
    "Cargo.toml"
  ],
  "rust-analyzer.procMacro.enable": true,
  "rust-analyzer.procMacro.server": null,
  "rust-analyzer.restartServerOnConfigChange": true
}
